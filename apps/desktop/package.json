{
  "name": "orchestra-desktop",
  "version": "0.1.0",
  "description": "Orchestra Agent Workspace for Developers",
  "homepage": "https://github.com/alcino-luvualo/orchestra",
  "author": {
    "name": "Alcino Luvualo",
    "email": "aluvualo@example.com"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test:portal-harness": "electron --no-sandbox portal-responsive-harness.mjs",
    "build": "tsc && vite build",
    "prepare:package": "npm --prefix ../.. run build:core && npm --prefix ../.. run verify:package-resources",
    "package:dir": "npm run prepare:package && npm run build && npx electron-builder --config electron-builder.yml --dir",
    "package:deb": "npm run prepare:package && npm run build && npx electron-builder --linux deb && node package-artifacts.js",
    "package:appimage": "npm run prepare:package && npm run build && npx electron-builder --linux AppImage && node package-artifacts.js",
    "package:all": "npm run prepare:package && npm run build && npx electron-builder --linux deb AppImage && node package-artifacts.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "app-builder-bin": "^4.0.0",
    "electron": "33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
